# Root ignore rules for the whole workspace. Package-specific rules live next to
# what they cover: apps/mobile/.gitignore (Expo), load/.gitignore (k6 sessions),
# supabase/.gitignore (written by the Supabase CLI).

# --- Dependencies ---------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
*.tgz

# --- Build output ---------------------------------------------------------------
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo

# --- Environment ----------------------------------------------------------------
# `.env.*` on purpose: any new dotenv variant is ignored by default rather than
# waiting for someone to remember to add it. `.env.example` is the one file we
# do track — it documents the variable names, never a value.
.env
.env.*
!.env.example

# --- Secrets and certificates ----------------------------------------------------
# Belt and braces: no key material of any kind is ever tracked.
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# --- Supabase local stack --------------------------------------------------------
# supabase/config.toml is TRACKED: `supabase db reset` and CI both read it.
supabase/.branches/
supabase/.temp/

# --- Generated ------------------------------------------------------------------
# `pnpm db:types` writes this from the running local database.
packages/db/src/supabase-types.ts

# --- Test artifacts -------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
blob-report/
test-results/
playwright/.cache/

# --- Logs -----------------------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- Caches ---------------------------------------------------------------------
.cache/
.eslintcache
.stylelintcache
.prettiercache
*.tmp
tmp/
temp/

# --- Deployment -----------------------------------------------------------------
.vercel

# --- Editors and IDEs -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.fleet/
.zed/
.history/
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating system -----------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini

# --- AI agent tooling -----------------------------------------------------------
# Per-developer state only; shared instructions live in the tracked CLAUDE.md /
# AGENTS.md files.
.claude/
.superpowers/
.worktrees/
validator_logs
