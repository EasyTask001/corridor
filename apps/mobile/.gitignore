# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
*.orig.*

# Native projects generated by `expo prebuild`
/ios
/android

# Local env (only EXPO_PUBLIC_* values belong here — never a service key).
# Signing material (*.jks, *.p8, *.p12, *.mobileprovision) is ignored at the root.
.env
.env.local
