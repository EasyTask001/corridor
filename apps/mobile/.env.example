# Base URL of the Next.js app that hosts /api/trpc.
# Use your machine's LAN IP (not localhost) when running on a physical handset.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Supabase project the driver signs in against. The anon key is the only
# credential the app may ever hold — never a service-role key.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
