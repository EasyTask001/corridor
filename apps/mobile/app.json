{
  "expo": {
    "name": "Corridor Driver",
    "slug": "corridor-driver",
    "scheme": "corridor",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corridor.driver"
    },
    "android": {
      "package": "com.corridor.driver",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Corridor uses the camera to photograph border paperwork.",
          "photosPermission": "Corridor attaches photos of paperwork to a movement."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
