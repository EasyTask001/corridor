# --- Supabase (from `supabase status` locally, or the Vercel Marketplace integration) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional non-public override of NEXT_PUBLIC_SUPABASE_URL, read only by SSO
# (readSsoEnv in @corridor/integrations). Falls back to NEXT_PUBLIC_SUPABASE_URL
# when unset — most setups never need this.
# SUPABASE_URL=

# Runtime queries: pooled (Supavisor transaction mode, port 6543 in the cloud)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Migrations / drizzle-kit introspection: direct connection (5432 in the cloud)
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Exception and trace reporting (required for production readiness) ---
# Server and browser DSNs may point to the same Sentry project. Event scrubbing
# removes provider envelopes, document content, credentials, routing keys, and PII.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Build-only source map upload settings (never exposed to the browser):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional OpenTelemetry-compatible metric export. If only the base endpoint is
# set, Corridor appends /v1/metrics. Headers use the standard comma-separated
# key=value format and belong in the secret manager.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_METRIC_EXPORT_INTERVAL=60000

# --- AI (Phase 4+) ---
# Provider precedence: AI_GATEWAY_API_KEY wins; OPENAI_API_KEY is the fallback;
# with neither set every AI feature runs in its deterministic local mode
# (mock extractor, mock embedder, mock copilot) and no network call is made.
AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=

# Model IDs per slot. Defaults, by provider:
#   gateway: anthropic/claude-sonnet-4.5 / anthropic/claude-sonnet-4.5 / openai/text-embedding-3-small
#   openai:  gpt-4.1-mini / gpt-4.1-mini / text-embedding-3-small
# The embedding model must be 1536-dimensional — that is the pgvector column width.
# CORRIDOR_EXTRACTION_MODEL=
# CORRIDOR_COPILOT_MODEL=
# CORRIDOR_EMBEDDING_MODEL=

# Force the deterministic paths even with a key configured (dev / CI):
# CORRIDOR_EXTRACTOR=mock
# CORRIDOR_EMBEDDER=mock

# Per-call deadlines for model/embedding calls, in ms. Defaults: 90000 / 20000.
# CORRIDOR_AI_TIMEOUT_MS_EXTRACTION=90000
# CORRIDOR_AI_TIMEOUT_MS_EMBEDDING=20000

# --- Cron (Vercel sets this automatically; any random string locally) ---
CRON_SECRET=

# --- Readiness (any random string; give it to internal monitoring only).
# Without a bearer matching this, GET /api/ready returns only { ok } — no
# queue depth, provider activity age, or missing-variable names. ---
READINESS_SECRET=

# --- auth.users Database Webhook (optional) ---
# Shared secret for POST /api/webhooks/supabase-auth, which syncs user_profiles
# with auth.users changes. Any opaque string; "whsec_" + base64 keeps it
# compatible with a Standard Webhooks signer too:
#   openssl rand -base64 24 | sed 's/^/whsec_/'
# Wire it as a Database Webhook on auth.users (Dashboard → Database → Webhooks,
# or the trigger SQL in supabase/config.toml's comment block) sending the header
#   x-corridor-webhook-secret: <this value>
# NOT as an Auth Hook — before_user_created is a gate whose non-2xx response
# denies the sign-up. Unset, the route returns 503 and never processes an
# unauthenticated payload; sign-up still works, because the
# on_auth_user_created trigger creates the profile.
SUPABASE_AUTH_WEBHOOK_SECRET=

# --- Tariff cache (optional) ---
# TTL for the in-process HS/HTS lookup cache in @corridor/integrations, in ms.
# Default 86400000 (24h).
# TARIFF_CACHE_TTL_MS=86400000

# --- Stripe (optional; billing runs in mock mode when absent) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
# Stripe meter `event_name` per usage metric (billing.report_usage). A metric with
# no override is reported under its own name. Only used when STRIPE_SECRET_KEY is
# set; without it usage is stamped with synthetic mock_<uuid> ids.
# STRIPE_METER_DOCUMENTS_EXTRACTED=
# STRIPE_METER_COPILOT_MESSAGES=
# STRIPE_METER_MOVEMENTS_TRANSMITTED=
# STRIPE_METER_AI_SUGGESTIONS=

# --- Upstash Redis (optional; rate limiting + caches fall back to in-process memory) ---
# Both must be set for Redis to be used. Without them the limiters and caches run
# in a per-process memory store — fine for local/dev, not shared across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Multiplier applied to the per-plan rate limits ONLY in the memory fallback, so a
# local Playwright run cannot trip the trial limits. Default: 1 in production,
# 10 everywhere else. Production limits per minute are:
#   standard  trial 60  starter 120  professional 300  enterprise 600
#   ai        trial 5   starter 20   professional 60   enterprise 120
# CORRIDOR_RATELIMIT_MULTIPLIER=10

# --- Background jobs ---
# Max jobs one organization may have running at once (claim_jobs per-org cap). Default 2.
# CORRIDOR_JOB_ORG_CAP=2
# How long a claimed job may stay `running` before another worker may take it over.
# Guards against a worker that dies mid-job holding one of its org's cap slots
# forever. Must exceed the longest handler run (the cron route allows 300s). Default 600.
# CORRIDOR_JOB_LEASE_SECONDS=600

# --- Outbound messaging (optional; both degrade to a logged mock when unset) ---
# Resend: notification e-mail, driver sheets to dispatch. Both required for live sends.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Twilio: entry-number texts to opted-in drivers, SMS notification channel. All three required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Customs gateway (optional; per-org `mode` on Settings → Integrations) ---
# With `mode = gateway` Corridor files through a certified EDI gateway's REST API.
# The base URL and API key can be set per organization (Vault) or here as the
# fallback; with neither, gateway mode replays packages/integrations/src/customs/
# gateway/fixtures so the full transmit → poll → decision path runs offline.
CUSTOMS_GATEWAY_BASE_URL=
CUSTOMS_GATEWAY_API_KEY=
# Shared secret for POST /api/webhooks/customs (HMAC-SHA256 over the raw body,
# hex in X-Corridor-Signature). Unset = every delivery is refused with 401.
CUSTOMS_GATEWAY_WEBHOOK_SECRET=
# --- BorderConnect eManifest API (Service Provider mode; a third customs filing
# mode alongside mock/gateway, see packages/integrations/src/customs/borderconnect/
# README.md). One service-provider account for every Corridor tenant; API key + URL suffix
# are account-wide, and organizations.border_connect_company_key tells tenants
# apart on the shared account. ---
BORDERCONNECT_API_URL_SUFFIX=
BORDERCONNECT_API_KEY=
# Fail-closed production gate. Keep false until a written provider-confirmed ACI
# amendment sequence completes a live CBSA round trip through Corridor.
BORDERCONNECT_ACI_AMEND_ENABLED=false
# Fail-closed production gate. Keep false until a live BorderConnect round trip
# with more than one trailer attached validates the loadedOn field (0051).
BORDERCONNECT_MULTI_TRAILER_ENABLED=false
# Fail-closed production gate. Keep false until a live BorderConnect round trip
# with a declared-empty trip is validated.
BORDERCONNECT_EMPTY_TRIP_ENABLED=false
# Encrypted pop-on-read receive spool. Use a persistent 0700 volume in live
# deployments and a random 32-byte key (hex or base64) from the secret manager.
BORDERCONNECT_SPOOL_DIR=
BORDERCONNECT_SPOOL_KEY=
# Test-only: a BorderConnect test carrier companyKey, read solely by
# packages/integrations/scripts/borderconnect-smoke.ts (never by application code).
BORDERCONNECT_TEST_COMPANY_KEY=
# --- Customs simulation controls ---
# CORRIDOR_ALLOW_CUSTOMS_SIMULATION=true   # enable the dev "customs response" buttons in production

# --- Help page support card (optional; all public, shown to every signed-in user) ---
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_URL=
